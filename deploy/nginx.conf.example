# /etc/nginx/sites-available/business-kit
# Статичний сайт (Vite). HTTPS додасть certbot: sudo certbot --nginx -d klitynka.online
server {
    listen 80;
    listen [::]:80;
    server_name klitynka.online;

    root /var/www/business-kit;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json application/xml text/plain;

    # Файли з хешем у назві (/assets/index-AbC123.js) не змінюються: кеш на рік
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/business-kit-security.conf;
    }

    # HTML і решта: браузер щоразу перевіряє свіжість, оновлення видно одразу.
    # Одна адреса на сторінку (docs/SEO-PLAN.md): /games віддається з games/index.html зі статусом 200 без редиректу,
    # /games/ веде на /games (301), невідома адреса отримує 404.html зі статусом 404, а не головну.
    location / {
        rewrite ^/(.+)/$ /$1 permanent;
        try_files $uri $uri/index.html =404;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/business-kit-security.conf;
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/business-kit-security.conf;
    }
}

# --- /etc/nginx/snippets/business-kit-security.conf --------------------------
# Окремий файл, бо add_header усередині location скасовує заголовки рівня server.
# Сайт не вантажить нічого стороннього (шрифти в збірці), тому політика сувора.
#
# add_header Strict-Transport-Security "max-age=31536000" always;
# add_header X-Content-Type-Options "nosniff" always;
# add_header Referrer-Policy "strict-origin-when-cross-origin" always;
# add_header X-Frame-Options "DENY" always;
# add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
